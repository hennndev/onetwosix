APP_NAME="126 Club"
APP_ENV=testing
APP_KEY=base64:dGVzdGluZ2R1bW15a2V5MTI2Y2x1YnYydGVzdHM9PT0=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# WAJIB sqlite: mencegah `artisan <cmd> --env=testing` jatuh ke MySQL dev (.env)
# dan menghapus database lokal. Jangan pernah arahkan ke mysql.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=4

# Placeholder (BUKAN kredensial nyata). EnsureDatabaseIsSelected melewati
# pengecekan session bila accurate.api_token terisi — tanpa ini semua request
# admin di test ter-redirect ke /select-database.
ACCURATE_API_TOKEN=testing-dummy-token
